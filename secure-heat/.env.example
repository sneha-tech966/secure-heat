# ======================= Secure-Heat environment =======================
# Copy to .env and fill in. NEVER commit .env. Generate secrets with:  openssl rand -base64 32

# --- Database ---
POSTGRES_USER=secureheat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secureheat
DATABASE_URL=postgresql://secureheat:change-me@localhost:5432/secureheat

# --- Backend ---
PORT=4000
NODE_ENV=development             # use "production" behind TLS (forces Secure cookies)
JWT_SECRET=                      # required, >= 32 chars
JWT_EXPIRES_SECONDS=3600
SENSOR_SECRET_ENC_KEY=           # required, 32 random bytes base64 (encrypts sensor HMAC secrets at rest)
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false                # true only when behind a reverse proxy you control
COOKIE_SECURE=false              # forced true when NODE_ENV=production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10           # failed logins per 15 min per IP
INGEST_RATE_LIMIT_MAX=600

SEED_ON_START=true              # Docker: seed demo users/sensors/SYNTHETIC history on start. Set false for anything real
# --- Seed (development accounts; passwords >= 12 chars; analyst/viewer optional) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ANALYST_EMAIL=
SEED_ANALYST_PASSWORD=
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=
SENSOR_CREDENTIALS_PATH=../sensor-simulator/credentials.json

# --- Telemetry security ---
TIMESTAMP_WINDOW_SECONDS=120
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=3000
ML_INTERNAL_TOKEN=               # shared secret between backend and ML service (set the same value on both)
ML_FAIL_MODE=quarantine          # quarantine | reject   (there is intentionally no pass-through mode)
RANGE_VIOLATION_ACTION=quarantine  # quarantine | reject  (impossible values, e.g. humidity=150)
FLAG_THRESHOLD=0.99              # percentile of clean calibration scores (0-1); FLAG = held for human review
QUARANTINE_THRESHOLD=0.999       # QUARANTINE = strong anomaly evidence
FORECASTING_URL=                 # optional external forecasting API; only ACCEPTed readings are ever sent
FORECASTING_TOKEN=

# --- ML service (same names are read by ml-service/app) ---
TRUSTED_MAX_AGE_MIN=60
REPEAT_LIMIT=3

# --- Simulator ---
SIMULATOR_URL=http://localhost:5055   # simulator control API (started with --control-port 5055); backend proxies to it
SIMULATOR_TOKEN=                     # must equal SIM_CONTROL_TOKEN given to the simulator
SIM_CONTROL_TOKEN=
BACKEND_URL=http://localhost:4000
